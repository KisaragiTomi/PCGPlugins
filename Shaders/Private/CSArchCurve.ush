// Shared CPU / GPU ellipse arc metric. Circles retain their exact old metric.
#ifndef CS_ARCH_CURVE_INCLUDED
#define CS_ARCH_CURVE_INCLUDED
#ifdef __cplusplus
#define CS_ARCH_INLINE inline
#define CS_ARCH_SIN FMath::Sin
#define CS_ARCH_COS FMath::Cos
#define CS_ARCH_SQRT FMath::Sqrt
#define CS_ARCH_ABS FMath::Abs
#define CS_ARCH_MAX FMath::Max
#else
#define CS_ARCH_INLINE
#define CS_ARCH_SIN sin
#define CS_ARCH_COS cos
#define CS_ARCH_SQRT sqrt
#define CS_ARCH_ABS abs
#define CS_ARCH_MAX max
#endif

CS_ARCH_INLINE float CSArch_Rise(float Radius, float Rise)
{
	return Rise > 0.0f ? Rise : Radius;
}

CS_ARCH_INLINE float CSArch_Speed(float Radius, float Rise, float Angle)
{
	float X = Radius * CS_ARCH_SIN(Angle);
	float Y = Rise * CS_ARCH_COS(Angle);
	return CS_ARCH_SQRT(X * X + Y * Y);
}

// Simpson integration per bin, then interpolation within the selected bin.
// The same 32 bins are used for length and inverse lookup on both processors.
CS_ARCH_INLINE float CSArch_BinLength(float Radius, float Rise, float A, float B)
{
	return (B - A) * (CSArch_Speed(Radius, Rise, A) + 4.0f * CSArch_Speed(Radius, Rise, (A + B) * 0.5f)
		+ CSArch_Speed(Radius, Rise, B)) / 6.0f;
}

CS_ARCH_INLINE float CSArch_Length(float Radius, float InRise, float Sweep)
{
	float Rise = CSArch_Rise(Radius, InRise);
	if (CS_ARCH_ABS(Radius - Rise) < 0.0001f) return Radius * Sweep;
	float Total = 0.0f;
	for (int I = 0; I < 32; ++I) Total += CSArch_BinLength(Radius, Rise, Sweep * float(I) / 32.0f, Sweep * float(I + 1) / 32.0f);
	return Total;
}

CS_ARCH_INLINE float CSArch_Angle(float Radius, float InRise, float Sweep, float Distance)
{
	float Rise = CSArch_Rise(Radius, InRise);
	if (CS_ARCH_ABS(Radius - Rise) < 0.0001f) return Distance / CS_ARCH_MAX(Radius, 0.0001f);
	float Remaining = CS_ARCH_MAX(Distance, 0.0f);
	for (int I = 0; I < 32; ++I)
	{
		float A = Sweep * float(I) / 32.0f;
		float B = Sweep * float(I + 1) / 32.0f;
		float L = CSArch_BinLength(Radius, Rise, A, B);
		if (Remaining <= L) return A + (B - A) * Remaining / CS_ARCH_MAX(L, 0.0001f);
		Remaining -= L;
	}
	return Sweep;
}

#undef CS_ARCH_INLINE
#undef CS_ARCH_SIN
#undef CS_ARCH_COS
#undef CS_ARCH_SQRT
#undef CS_ARCH_ABS
#undef CS_ARCH_MAX
#endif
