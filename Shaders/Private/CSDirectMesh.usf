// Packs a world-space triangle soup (float4 positions + float4 normals, 3 verts per
// triangle) produced by the compute-shader mesh generator into LocalVertexFactory
// streams — positions, a packed tangent basis, zero UV and white vertex colour — plus
// an identity index buffer, and builds DrawIndexedIndirect args from the GPU triangle
// counter. The vertex layout matches RoadBuilder.usf so both share the same draw path
// in FCSGpuMeshSceneProxy. Positions/normals stay in world space; the owning component
// renders with an identity transform, so no local/world conversion is needed here.
// Nothing is read back to the CPU.

#include "/Engine/Public/Platform.ush"

Buffer<float4> InVertices;   // triangle soup, xyz = world position, w = 1
Buffer<float4> InNormals;    // triangle soup, xyz = world normal,   w = 0
Buffer<uint>   InCounter;    // InCounter[0] = triangle count; valid vertices = *3

RWBuffer<float> RWPositions; // 3 floats / vertex
RWBuffer<uint>  RWTangents;  // 2 packed 8888 SNORM / vertex (TangentX, TangentZ)
RWBuffer<float> RWTexCoords; // 2 floats / vertex (always 0)
RWBuffer<uint>  RWColors;    // 1 packed RGBA8 / vertex (always white)
RWBuffer<uint>  RWIndices;   // identity index buffer (soup is already a triangle list)
RWBuffer<uint>  RWIndirectArgs; // DrawIndexedIndirect: 5 uints
RWBuffer<uint>  RWMeshCounters; // [0] = vertexCount, [1] = indexCount (CPU readback carrier)

uint MaxVertices;

// Byte-for-byte identical to RoadBuilder.usf so both feed the same VET_PackedNormal /
// PF_R8G8B8A8_SNORM tangent stream.
uint PackSnorm8888(float4 V)
{
	int4 I = int4(round(clamp(V, -1.0, 1.0) * 127.0));
	return (uint(I.x) & 0xFF) | ((uint(I.y) & 0xFF) << 8) | ((uint(I.z) & 0xFF) << 16) | ((uint(I.w) & 0xFF) << 24);
}

[numthreads(64, 1, 1)]
void PackTrianglesCS(uint3 Id : SV_DispatchThreadID)
{
	const uint V = Id.x;
	if (V >= MaxVertices) return;

	// Identity index / constant UV+colour for every vertex slot in the capacity.
	RWIndices[V] = V;
	RWTexCoords[V * 2 + 0] = 0.0f;
	RWTexCoords[V * 2 + 1] = 0.0f;
	RWColors[V] = 0xffffffffu;

	const uint ValidVerts = InCounter[0] * 3u;
	float3 P = (V < ValidVerts) ? InVertices[V].xyz : float3(0.0f, 0.0f, 0.0f);
	float3 N = (V < ValidVerts) ? InNormals[V].xyz  : float3(0.0f, 0.0f, 1.0f);

	N = normalize(N);
	if (!all(isfinite(N))) N = float3(0.0f, 0.0f, 1.0f);

	// Arbitrary tangent perpendicular to the normal (materials rarely need a precise one).
	float3 Helper = (abs(N.z) < 0.99f) ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
	float3 TanX = normalize(cross(Helper, N));
	if (!all(isfinite(TanX))) TanX = float3(1.0f, 0.0f, 0.0f);

	RWPositions[V * 3 + 0] = P.x;
	RWPositions[V * 3 + 1] = P.y;
	RWPositions[V * 3 + 2] = P.z;
	RWTangents[V * 2 + 0] = PackSnorm8888(float4(TanX, 0.0f)); // TangentX
	RWTangents[V * 2 + 1] = PackSnorm8888(float4(N, 1.0f));    // TangentZ (+w sign)
}

[numthreads(1, 1, 1)]
void BuildIndirectArgsCS(uint3 Id : SV_DispatchThreadID)
{
	const uint IndexCount = min(InCounter[0] * 3u, MaxVertices);
	RWIndirectArgs[0] = IndexCount; // IndexCountPerInstance
	RWIndirectArgs[1] = 1;          // InstanceCount
	RWIndirectArgs[2] = 0;          // StartIndexLocation
	RWIndirectArgs[3] = 0;          // BaseVertexLocation
	RWIndirectArgs[4] = 0;          // StartInstanceLocation

	// The soup has a unique vertex per index (identity index buffer), so vertexCount == indexCount.
	RWMeshCounters[0] = IndexCount; // vertexCount
	RWMeshCounters[1] = IndexCount; // indexCount
}
