// Shared GPU debug geometry: one kernel per debug shape, all writing the same layout.
//
// Positions are three floats per vertex — the local vertex factory fetches them manually as
// Buffer<float> indexed at VertexId*3, so this layout is not negotiable. Counts stay on the
// GPU: BuildIndirectArgsCS turns a GPU-written voxel counter into DrawIndexedIndirect args,
// so nothing here is ever read back.

#include "/Engine/Public/Platform.ush"

// --- outputs (each kernel binds only what it writes)
RWBuffer<float> RWDebugPositions;
RWBuffer<uint> RWDebugIndices;
RWBuffer<uint> RWDebugPointIndices;
RWBuffer<uint> RWDebugIndirectArgs;

// --- sources
StructuredBuffer<float4> InSourcePositions;
StructuredBuffer<int4> InLineIndexPairs;
Buffer<float4> InVoxelPositions;
Buffer<float4> InVoxelNormals;
Buffer<uint> InVoxelCounter;

uint NumPositions;
uint NumSegments;
uint VoxelCapacity;
uint MaxItems;
uint IndicesPerItem;
uint bReverseOrientation;
float VoxelSize;
float DirectionLength;
float QuadScale;
float NormalOffsetScale;

void WriteDebugPosition(uint VertexIndex, float3 Position)
{
	RWDebugPositions[VertexIndex * 3u + 0u] = Position.x;
	RWDebugPositions[VertexIndex * 3u + 1u] = Position.y;
	RWDebugPositions[VertexIndex * 3u + 2u] = Position.z;
}

float3 SafeNormal(float3 Value)
{
	const float LengthSquared = dot(Value, Value);
	if (!all(isfinite(Value)) || LengthSquared < 1.0e-8f) return float3(0.0f, 0.0f, 1.0f);
	return Value * rsqrt(LengthSquared);
}

// Repacks a float4 position source into the debug layout's float triples.
[numthreads(64, 1, 1)]
void UnpackPositionsCS(uint3 Id : SV_DispatchThreadID)
{
	const uint VertexIndex = Id.x;
	if (VertexIndex >= NumPositions) return;
	WriteDebugPosition(VertexIndex, InSourcePositions[VertexIndex].xyz);
}

// One line per voxel along its normal, plus one point index at the voxel centre.
[numthreads(64, 1, 1)]
void BuildVoxelDirectionsCS(uint3 Id : SV_DispatchThreadID)
{
	const uint VoxelIndex = Id.x;
	if (VoxelIndex >= MaxItems || VoxelIndex >= VoxelCapacity) return;

	const float3 Position = InVoxelPositions[VoxelIndex].xyz;
	const float3 Normal = SafeNormal(InVoxelNormals[VoxelIndex].xyz);
	const uint BaseVertex = VoxelIndex * 2u;
	WriteDebugPosition(BaseVertex + 0u, Position);
	WriteDebugPosition(BaseVertex + 1u, Position + Normal * DirectionLength);
	RWDebugIndices[BaseVertex + 0u] = BaseVertex + 0u;
	RWDebugIndices[BaseVertex + 1u] = BaseVertex + 1u;
	RWDebugPointIndices[VoxelIndex] = BaseVertex;
}

// One normal-facing quad per voxel: 4 vertices, 2 triangles.
[numthreads(64, 1, 1)]
void BuildVoxelQuadsCS(uint3 Id : SV_DispatchThreadID)
{
	const uint VoxelIndex = Id.x;
	if (VoxelIndex >= MaxItems || VoxelIndex >= VoxelCapacity) return;

	const float3 Position = InVoxelPositions[VoxelIndex].xyz;
	const float3 Normal = SafeNormal(InVoxelNormals[VoxelIndex].xyz);
	const float3 Helper = abs(Normal.z) < 0.99f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
	const float3 AxisX = SafeNormal(cross(Helper, Normal));
	const float3 AxisY = SafeNormal(cross(Normal, AxisX));
	const float3 Center = Position + Normal * (VoxelSize * NormalOffsetScale);
	const float HalfSize = max(VoxelSize * QuadScale * 0.5f, 1.0e-4f);
	const float3 DX = AxisX * HalfSize;
	const float3 DY = AxisY * HalfSize;

	const uint BaseVertex = VoxelIndex * 4u;
	const uint BaseIndex = VoxelIndex * 6u;
	WriteDebugPosition(BaseVertex + 0u, Center - DX - DY);
	WriteDebugPosition(BaseVertex + 1u, Center + DX - DY);
	WriteDebugPosition(BaseVertex + 2u, Center + DX + DY);
	WriteDebugPosition(BaseVertex + 3u, Center - DX + DY);

	const uint2 Winding = bReverseOrientation != 0u ? uint2(2u, 1u) : uint2(1u, 2u);
	RWDebugIndices[BaseIndex + 0u] = BaseVertex + 0u;
	RWDebugIndices[BaseIndex + 1u] = BaseVertex + Winding.x;
	RWDebugIndices[BaseIndex + 2u] = BaseVertex + Winding.y;
	RWDebugIndices[BaseIndex + 3u] = BaseVertex + 0u;
	RWDebugIndices[BaseIndex + 4u] = BaseVertex + (bReverseOrientation != 0u ? 3u : 2u);
	RWDebugIndices[BaseIndex + 5u] = BaseVertex + (bReverseOrientation != 0u ? 2u : 3u);
}

// One line per (start, end) vertex-index pair. Lets a producer that already knows its
// connectivity draw it without owning an index-building kernel.
[numthreads(64, 1, 1)]
void BuildLineIndicesCS(uint3 Id : SV_DispatchThreadID)
{
	const uint SegmentIndex = Id.x;
	if (SegmentIndex >= NumSegments) return;
	const int4 Segment = InLineIndexPairs[SegmentIndex];
	RWDebugIndices[SegmentIndex * 2u + 0u] = (uint)max(Segment.x, 0);
	RWDebugIndices[SegmentIndex * 2u + 1u] = (uint)max(Segment.y, 0);
}

// DrawIndexedIndirect args from the GPU-written item counter. IndicesPerItem is 2 for lines,
// 6 for quads, 1 for points; 0 emits an empty draw.
[numthreads(1, 1, 1)]
void BuildIndirectArgsCS(uint3 Id : SV_DispatchThreadID)
{
	const uint ValidItems = min(min(InVoxelCounter[0], MaxItems), VoxelCapacity);
	RWDebugIndirectArgs[0] = ValidItems * IndicesPerItem;
	RWDebugIndirectArgs[1] = 1u;
	RWDebugIndirectArgs[2] = 0u;
	RWDebugIndirectArgs[3] = 0u;
	RWDebugIndirectArgs[4] = 0u;
}
