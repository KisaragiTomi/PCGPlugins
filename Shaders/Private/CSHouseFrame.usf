// 门框砖的 **100% GPU 解析推导**（TinyGladeHouse D6；2026-08-30「裁决一」选乙）。
//
// **一线程一砖**：线程 i 直接从「拱参数 + 墙框架」算出第 i 块砖的位置与朝向，中间没有样条、
// 没有逐砖记录、没有原子累加。与已删的 `CSGroundSteps.usf` 那条路的差别不是"少一步"：
//   · 那边每条曲线先跑一次 `RDG_SmoothSpline`（一个 dispatch）求值出采样点，再跑一次散布
//     （又一个 dispatch）按记录里的 alpha 在采样点之间插值；这里**整栋房子一个 dispatch**。
//   · 那边的槽位靠 `InterlockedAdd` 抢 ⇒ 逐实例随机数由线程组完成顺序决定（S1 栽过一次：
//     "画一笔路全场变色"且没有任何断言会红）；这里槽位**恒等于砖序号**，随机数是砖身份的
//     纯函数。
//   · 那边的实例数随砖数走 ⇒ 容量要能扩 ⇒ 扩容那一趟是阻塞刷新；这里容量恒定，超了就少摆。
//
// 砖路的解析形状与「为什么骑在 clip 场那条曲线上」都写在 `CSHouseFrame.h` 的文件头，
// 这里不重复。**`FrameEvalPath` 是 `CSHouseFrame::EvalPath` 的逐字翻译，两处必须一起改** ——
// 写不一样的症状是"单测说砖在这儿、画面上砖在那儿"，而两边各自都自洽（同 `CSHouse_ClipKeeps`
// 与材质那对判据的纪律）。
//
// 逐路常量 = CS_HOUSE_FRAME_PATH_FLOAT4S（8）个 float4（`CSHouseFrame_Flatten` 是 CPU 侧的同一份定义）：
//   [0] Origin.xyz（墙空间原点的世界坐标）    | CenterS
//   [1] AxisU.xyz（沿边，单位）               | Radius
//   [2] AxisV.xyz（竖直，单位）               | TopZ
//   [3] BaseZ | LeftS | RightS | MidMeasure（圆弧 = 扫角，平顶 = 长度）
//   [4] asuint 位标志 | asuint 砖序起点 | asuint 砖数 | Pitch（相邻砖中心距）
//   [5] HalfLen（首块砖的弧长）| LayoutScale（长度轴铺装缩放）| asuint 随机数基 | CrossScale（横截面缩放，柱头/柱础）
//   [6] CullBelowZ（世界 Z 低于它的砖写负值随机数 ⇒ 材质 discard；≤ 0 = 不剔）
//       | ShearAtS0 | ShearAtS1 | Jitter；角石分支下 yz = 1 / 基础网格的 X、Z 尺寸
//   [7] SplitJitter（分层抖动幅度 cm，≤ 0 = 等分）| 本条路的总弧长（kernel 拿它把 cm 归一化）| QuoinScale（> 0 = 按相邻墙面包角）| 保留
//
// packed 行布局照抄 CSGpuInstancedMesh.usf：前三行是被缩放过的基（**矩阵的行**），第 4 行是
// 原点 + 每实例随机数，第 5 行是剔除球（必须包住变换后的基础网格，否则实例会在视锥边缘闪掉）。
// 基的约定与已删的 `CSGroundSteps.usf` **逐字相同**，迁移前后砖的朝向因此逐块一致：
//   +X = 面内朝外（砖的进深 FrameBrickDepth）
//   +Y = 路径切向的**反向**（砖的长度轴；旧 kernel 的 `AxisY = cross(N, AxisX)` 在翻号之后
//        恒等于 −T，这里直接写成 −T，省掉那三步"求径向 + 投影 + 判号"）
//   +Z = X × Y，恒等于墙外法线（对称砖盒下符号无关紧要，但行列式必须为正，否则实例是镜像、
//        法线朝里、光照当场坏掉）

#include "/Engine/Public/Platform.ush"

#ifndef THREADGROUPSIZE_X
#define THREADGROUPSIZE_X 64
#endif

// 逐路 stride 与位标志：与 `CSHouseFrame.cpp` 共用 CSGpuSharedLayout.ush 里的同一份 #define，
// 这里只起本文件用惯的短名。
#include "/Plugin/PCGPlugins/Shaders/Private/CSGpuSharedLayout.ush"
#include "/Plugin/PCGPlugins/Shaders/Private/CSHouseQuoinLayout.ush"
#define FRAME_PATH_STRIDE     CS_HOUSE_FRAME_PATH_FLOAT4S
#define FRAME_FLAG_LEFT_JAMB  CS_HOUSE_FRAME_FLAG_LEFT_JAMB
#define FRAME_FLAG_RIGHT_JAMB CS_HOUSE_FRAME_FLAG_RIGHT_JAMB
#define FRAME_FLAG_MID_ARC    CS_HOUSE_FRAME_FLAG_MID_ARC
#define FRAME_FLAG_MID_FLAT   CS_HOUSE_FRAME_FLAG_MID_FLAT

StructuredBuffer<float4> FramePaths;   // FRAME_PATH_STRIDE 个 float4 / 砖路

RWBuffer<float4> RWFrameInstances;     // CS_GPU_INSTANCED_ROW_FLOAT4S 个 float4 / 实例
RWBuffer<uint>   RWFrameCounter;       // [0] = 活跃实例数

float4x4 FrameWorldToComponent;
float3   FrameBaseSphereCentre;        // 基础网格局部包围球心（未缩放）
float3   FrameBlockSize;               // 三轴块尺寸（TG 的 brick 是 100³ 居中盒 ⇒ 非均匀缩放就是砖尺寸）
float    FrameBaseSphereRadius;
uint     FramePathCount;
uint     FrameBrickTotal;
uint     FrameMaxInstances;

/** 与 CSGpuInstancedMesh.usf:120-126 同一份哈希，CPU/GPU 两条路的 PerInstanceRandom 才对得上。 */
float FrameInstanceRandom(uint Index)
{
	uint H = Index * 747796405u + 2891336453u;
	H = ((H >> ((H >> 28) + 4u)) ^ H) * 277803737u;
	return float((H >> 22 ^ H) & 0xFFFFFFu) / float(0x1000000u);
}

/**
 * 弧长 → 墙空间 (S, Z) 与单位切向。**`CSHouseFrame::EvalPath` 的逐字翻译。**
 *
 * 分支顺序即段序，每段都带"我存在吗"与"我后面还有段吗"的前置判断：退化路径
 * （只有中段的圆洞 / 只有左段的墩）因此不会掉进后面那段的公式里去算出一个看着合理的错位置。
 */
void FrameEvalPath(uint Flags, float BaseZ, float TopZ, float LeftS, float RightS,
	float CenterS, float Radius, float MidMeasure, float Arc,
	out float2 OutSZ, out float2 OutTangent)
{
	const float JambLen = max(TopZ - BaseZ, 0.0f);
	const bool bLeft = (Flags & FRAME_FLAG_LEFT_JAMB) != 0u;
	const bool bRight = (Flags & FRAME_FLAG_RIGHT_JAMB) != 0u;
	const float L0 = bLeft ? JambLen : 0.0f;
	const float L2 = bRight ? JambLen : 0.0f;
	float L1 = 0.0f;
	if (Flags & FRAME_FLAG_MID_ARC)  L1 = max(Radius, 0.0f) * MidMeasure;
	if (Flags & FRAME_FLAG_MID_FLAT) L1 = max(MidMeasure, 0.0f);

	const float Total = L0 + L1 + L2;
	const float A = clamp(Arc, 0.0f, max(Total, 0.0f));

	if (L0 > 0.0f && (A <= L0 || (L1 <= 0.0f && L2 <= 0.0f)))
	{
		OutSZ = float2(LeftS, BaseZ + min(A, L0));
		OutTangent = float2(0.0f, 1.0f);
		return;
	}
	if (L1 > 0.0f && (A <= L0 + L1 || L2 <= 0.0f))
	{
		const float T = min(A - L0, L1);
		if (Flags & FRAME_FLAG_MID_ARC)
		{
			const float Theta = Radius > 1e-4f ? T / Radius : 0.0f;
			float SinT, CosT;
			sincos(Theta, SinT, CosT);
			OutSZ = float2(CenterS - Radius * CosT, TopZ + Radius * SinT);
			OutTangent = float2(SinT, CosT);   // θ=0 → (0,1)，θ=π → (0,−1)：与两侧竖直段切向连续
		}
		else
		{
			OutSZ = float2(LeftS + T, TopZ);
			OutTangent = float2(1.0f, 0.0f);
		}
		return;
	}
	if (L2 > 0.0f)
	{
		OutSZ = float2(RightS, TopZ - min(A - L0 - L1, L2));
		OutTangent = float2(0.0f, -1.0f);
		return;
	}
	OutSZ = float2(LeftS, BaseZ);
	OutTangent = float2(0.0f, 1.0f);
}

[numthreads(THREADGROUPSIZE_X, 1, 1)]
void ScatterHouseFrameCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint Brick = DispatchThreadId.x;
	if (Brick >= FrameBrickTotal) return;

	// counter 由 0 号线程直接写死 —— 砖数是 CPU 算好的标量（`CSHouseFrame::SolveRun`），
	// 不需要原子累加。组件永远不会替我们清 counter，所以这一句是必需的而不是优化。
	if (Brick == 0u) RWFrameCounter[0] = min(FrameBrickTotal, FrameMaxInstances);
	if (Brick >= FrameMaxInstances) return;   // 越界写是静默的：宁可少摆一块，也不能踩出 buffer

	// 找到自己属于哪条砖路。一面墙上的砖路数是"洞数 × 2"量级（默认参数下整栋房子 ≤ 32），
	// 线性扫比二分短、也没有边界条件可写错；而且这一步与砖数无关，砖再多也不变慢。
	uint Path = FramePathCount;
	uint Begin = 0u;
	uint Count = 0u;
	for (uint K = 0u; K < FramePathCount; ++K)
	{
		const uint4 Ints = asuint(FramePaths[K * FRAME_PATH_STRIDE + 4u]);
		if (Brick >= Ints.y && Brick < Ints.y + Ints.z)
		{
			Path = K;
			Begin = Ints.y;
			// 砖路的长度也要带出循环 —— 下面判 bLast 要它。区间是 [Ints.y, Ints.y + Ints.z)，
			// 上面那行 if 的条件本身就是这条口径的证据。
			Count = Ints.z;
			break;
		}
	}
	if (Path >= FramePathCount) return;   // 砖序与元素表对不上（不该发生）：宁可少摆

	const uint Base = Path * FRAME_PATH_STRIDE;
	const float4 R0 = FramePaths[Base + 0u];
	const float4 R1 = FramePaths[Base + 1u];
	const float4 R2 = FramePaths[Base + 2u];
	const float4 R3 = FramePaths[Base + 3u];
	const float4 R4 = FramePaths[Base + 4u];
	const float4 R5 = FramePaths[Base + 5u];
	const float4 R6 = FramePaths[Base + 6u];
	const float4 R7 = FramePaths[Base + 7u];

	const float3 Origin = R0.xyz;
	const float3 AxisU = R1.xyz;
	const float3 AxisV = R2.xyz;
	const uint Flags = asuint(R4.x);
	const float Pitch = R4.w;
	const float HalfLen = R5.x;
	const float LayoutScale = max(R5.y, 1e-4f);
	// 随机数序号来自**路**而不是槽位（`CSHouseFrame::FElement::RandomBase`）。门框砖填的就是
	// BrickBegin ⇒ 逐位等于旧写法的全局槽位；接缝砖填的是接缝身份哈希，两栋房各画一份重叠的
	// 砖时才能拿到同一个值（裁决二：接缝零归属，两边都画）。
	const uint RandomIndex = asuint(R5.z) + (Brick - Begin);

	// 第 i 块砖的弧长：首块居中在 HalfLen，之后每块推进一个中心距。
	// **与 `CSShaperSteps` 那条路的 `Cursor += BlockLength + Gap*Scale` 逐字等价**，
	// 只是不再需要把它折成一个样条参数 alpha 再插值回来。
	float Arc = HalfLen + float(Brick - Begin) * Pitch;
	// 分层随机化之后每块砖的长度不再相同，这一格记的是"相对等分那版要乘多少"（1 = 不变）。
	float SplitLenMul = 1.0f;

	// ---- 分层随机化（`FElement::SplitJitter`，走 R7）：TG `utils::random_splits` 的逐砖形态 ----
	//
	// TG 是 CPU 上一次算出整条 `Vec<f32>` 分点；我们一线程一砖，所以改成**每块砖现算自己的两个
	// 边界**（第 i 与第 i+1 个分点）。数学完全一样，只是不落数组 —— 这也正是本 kernel 一贯的
	// "从参数解析推导，不排记录"的形态。
	//
	// TG 原式（VA 0x140C90050，常量全部实读自 .rdata）：
	//     step = 1/(splits-1);  amp = min(jitter, 0.495*step)
	//     s_0 = 0;  s_k = k*step + (rand_k - 0.5)*amp;  s_{splits-1} = 1
	// 这里 `splits-1` = 本条路的砖数 `Count`，所以边界 k = 0..Count，砖 i 吃 [s_i, s_{i+1}]。
	//
	// ⚠️ **0.495 不能写成 0.5**：它把抖幅夹到不到半个间距，保证分点永远保序、相邻间距
	//    最小 `0.505*step > 0`，**不会退化出零厚度的砖**。TG 留这一丝余量是有意的。
	// ⚠️ 边界的随机数用**另一条盐**（+0x9E3779B9），不能与逐砖随机数同源 —— 同源会让
	//    "这块砖多高"与"它横向偏多少"完全相关，读起来像有规律，而不是两次独立的随机。
	const float SplitJitterCm = R7.x;
	const float PathTotalLen = R7.y;
	if (SplitJitterCm > 0.0f && Count >= 2u && PathTotalLen > 1e-3f)
	{
		const uint I = Brick - Begin;
		const float Step = 1.0f / float(Count);
		// cm → 归一化；再夹到 0.495 个间距。
		const float Amp = min(SplitJitterCm / PathTotalLen, 0.495f * Step);
		const uint SplitSalt = asuint(R5.z) + 0x9E3779B9u;
		// 两端固定为 0 与 1（TG 显式写死 out[0]=0 / out[last]=1）。
		const float S0 = (I == 0u) ? 0.0f
			: (float(I) * Step + (FrameInstanceRandom(SplitSalt + I) - 0.5f) * Amp);
		const float S1 = (I + 1u >= Count) ? 1.0f
			: (float(I + 1u) * Step + (FrameInstanceRandom(SplitSalt + I + 1u) - 0.5f) * Amp);

		// 缝宽保持等分那版的绝对值：`Pitch = (Length+Gap)*Scale`、`HalfLen = Length*Scale/2`
		// ⇒ `Gap*Scale = Pitch - 2*HalfLen`。只让砖身随区间伸缩，缝不跟着抖。
		const float GapWorld = max(Pitch - 2.0f * HalfLen, 0.0f);
		const float SpanLen = (S1 - S0) * PathTotalLen;
		const float BodyLen = max(SpanLen - GapWorld, 0.05f * max(2.0f * HalfLen, 1e-3f));
		Arc = 0.5f * (S0 + S1) * PathTotalLen;
		SplitLenMul = BodyLen / max(2.0f * HalfLen, 1e-3f);
	}

	float2 SZ, TangentSZ;
	FrameEvalPath(Flags, R3.x, R2.w, R3.y, R3.z, R0.w, R1.w, R3.w, Arc, SZ, TangentSZ);

	// 面内朝外法线 = 切向逆时针转 90°。旧 kernel 要靠"减去曲线中心求径向 + 投影掉平面法线
	// + 判号翻转"三步才得到同一个方向，那三步在拱心退化时会翻错号；这里没有可翻错的号。
	const float2 OutwardSZ = float2(-TangentSZ.y, TangentSZ.x);

	float3 WorldPos = Origin + AxisU * SZ.x + AxisV * SZ.y;
	float3 AxisX = AxisU * OutwardSZ.x + AxisV * OutwardSZ.y;
	const float3 AxisY = -(AxisU * TangentSZ.x + AxisV * TangentSZ.y);
	float3 AxisZ = cross(AxisX, AxisY);   // 恒等于墙外法线；用叉积保证行列式为正

	const float QuoinScale = R7.z;
	const bool bQuoin = QuoinScale > 0.0f;
	FQuoinPlacement Quoin = (FQuoinPlacement)0;
	if (bQuoin)
	{
		Quoin = PlaceQuoin(WorldPos, AxisX.x, AxisX.y, QuoinScale,
			R6.w * (2.0f * FrameInstanceRandom(RandomIndex) - 1.0f), ((Brick - Begin) & 1u) != 0u);
		WorldPos = Quoin.Center;
		AxisX = Quoin.AxisX;
		AxisZ = Quoin.AxisZ;
	}
	else if (R6.w > 0.0f)
	{
		WorldPos += AxisX * (R6.w * (2.0f * FrameInstanceRandom(RandomIndex) - 1.0f));
	}

	const float3 LocalX = mul(float4(AxisX, 0.0f), FrameWorldToComponent).xyz;
	const float3 LocalY = mul(float4(AxisY, 0.0f), FrameWorldToComponent).xyz;
	const float3 LocalZ = mul(float4(AxisZ, 0.0f), FrameWorldToComponent).xyz;
	float3 LocalOrigin = mul(float4(WorldPos, 1.0f), FrameWorldToComponent).xyz;

	// 长度轴额外吃铺装缩放（`SolveRun` 把整条路恰好铺满就靠它）。
	float3 BlockScale = FrameBlockSize;
	if (dot(BlockScale, BlockScale) < 1e-8f) BlockScale = float3(1.0f, 1.0f, 1.0f);
	BlockScale.y *= LayoutScale * SplitLenMul;
	// 横截面缩放（柱头 / 柱础）：进深轴与墙法线轴同乘。≤ 0 = 旧数据没填这一格，按 1 处理。
	const float CrossScale = R5.w > 1e-4f ? R5.w : 1.0f;
	BlockScale.x *= CrossScale;
	BlockScale.z *= CrossScale;
	if (bQuoin)
	{
		BlockScale.x = Quoin.LongSize * R6.y;
		BlockScale.z = Quoin.ShortSize * R6.z;
		// Accommodate an off-center base mesh without shifting the two anchored faces.
		LocalOrigin -= LocalX * (BlockScale.x * FrameBaseSphereCentre.x)
			+ LocalZ * (BlockScale.z * FrameBaseSphereCentre.z);
	}

	float3 ScaledX = LocalX * BlockScale.x;
	const float3 ScaledY = LocalY * BlockScale.y;
	const float3 ScaledZ = LocalZ * BlockScale.z;

	// -------------------------------------------------------------------------
	// 洞缘四级之③：端头那块砖**剪切**成上宽下窄，贴住收窄的洞缘
	// -------------------------------------------------------------------------
	// ①按剪影裁行时切口取的是"带内最宽的那个高度"，于是拱圈往上收的那一头会在砖与洞之间
	// 留一条缝。把端头砖的**顶边**朝洞多推出 Shear、底边不动，缝就没了。
	// TG 对位物是 `flags & 32` 的"局部 z 按拱高曲线缩放"—— 同一件事的另一种参数化。
	//
	// ⚠️ 剪切**不加任何逐实例数据**：基是三个任意向量，倾斜高度轴就是一次剪切。
	// 平顶段的轴向是 +X 朝上、+Y 沿 −S（见文件头），所以"朝 +S"就是 −ScaledY 方向。
	const float ShearAtS0 = bQuoin ? 0.0f : R6.y;
	const float ShearAtS1 = bQuoin ? 0.0f : R6.z;
	const bool bFirst = (Brick == Begin);
	const bool bLast  = (Brick + 1u == Begin + Count);
	// 只有一块砖而两端都挨着洞时取较大的那个：剪切是平行四边形，一个自由度救不了梯形。
	// 硬凑两头会把砖推进洞里，而画面上只是"洞缘多了一小块"——不会有任何断言报红。
	const float ShearFirst = bFirst ? ShearAtS0 : 0.0f;
	const float ShearLast  = bLast  ? ShearAtS1 : 0.0f;
	const float Shear = (ShearLast >= ShearFirst) ? ShearLast : -ShearFirst;   // 正 = 朝 +S
	if (abs(Shear) > 1e-4f)
	{
		// −ScaledY 是 +S。ScaledY 已含铺装缩放，取单位向量才不会让剪切量跟着砖长缩放。
		const float3 AlongS = -normalize(ScaledY);
		// 局部 x ∈ [−0.5, 0.5] ⇒ 给基加 `AlongS * Shear` 让顶边 +Shear/2、底边 −Shear/2；
		// 再把原点推 +Shear/2 就变成"底边不动、顶边 +Shear"。
		ScaledX += AlongS * Shear;
		LocalOrigin += AlongS * (Shear * 0.5f);
	}

	const uint Row = Brick * CS_GPU_INSTANCED_ROW_FLOAT4S;
	RWFrameInstances[Row + 0u] = float4(ScaledX, 0.0f);   // .w 必须是 0：引擎拿它做选中/hitproxy
	RWFrameInstances[Row + 1u] = float4(ScaledY, 0.0f);
	RWFrameInstances[Row + 2u] = float4(ScaledZ, 0.0f);
	// 逐实例随机数的**负值哨兵** = 材质里的剔除位（`FElement::CullBelowZ`）。真实随机数恒 ≥ 0，
	// 所以 −1 不会与任何取值相撞；`M_TinyGladeBrick` 的 OpacityMask = saturate(PerInstanceRandom + 1)
	// 把它裁掉。比较用**世界** Z（`WorldPos` 还没进组件空间），与 CPU 侧填的口径一致。
	const float CullBelowZ = R6.x;
	const float InstanceRandom = (CullBelowZ > 0.0f && WorldPos.z < CullBelowZ)
		? -1.0f
		: FrameInstanceRandom(RandomIndex);
	RWFrameInstances[Row + 3u] = float4(LocalOrigin, InstanceRandom);

	const float3 SphereCentre = LocalOrigin
		+ ScaledX * FrameBaseSphereCentre.x
		+ ScaledY * FrameBaseSphereCentre.y
		+ ScaledZ * FrameBaseSphereCentre.z;
	// 剔除球必须包住**变换后**的基础网格：基向量是单位长，所以按最大轴缩放放大即可。
	// 少放大一点点就会在视锥边缘闪掉实例，而且只在斜看时出现，最难复现。
	const float MaxAxisScale = max(BlockScale.x, max(BlockScale.y, BlockScale.z));
	// 剪切把砖撑宽了，剔除球要跟着涨 —— 少涨一点就会在视锥边缘闪掉，且只在斜看时出现。
	RWFrameInstances[Row + 4u] = float4(SphereCentre,
		FrameBaseSphereRadius * max(MaxAxisScale, 1e-3f) + abs(Shear));
}
